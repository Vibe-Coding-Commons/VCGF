{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vibe-Coding-Commons/VCGF/schemas/v1.2.0/release-evidence.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 Eng. Hamada Sami; SPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "candidate_commit",
    "policy_sha256",
    "created_at",
    "valid_until",
    "checks"
  ],
  "properties": {
    "contract_version": {
      "const": "1.2.0"
    },
    "candidate_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "scope",
          "artifacts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not_run",
              "blocked"
            ]
          },
          "scope": {
            "enum": [
              "local_fixture",
              "full_repository",
              "target_project",
              "manual_target_project",
              "authorized_sandbox",
              "trusted_host"
            ]
          },
          "artifacts": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
