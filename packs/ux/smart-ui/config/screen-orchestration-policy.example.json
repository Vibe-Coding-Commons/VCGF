{
  "schema_version": "1.0.0",
  "policy_version": "0.5.0",
  "activation_policy": "composition-selected-only",
  "enabledCompositions": [],
  "defaults": {
    "densityPolicy": "adaptive",
    "primaryActionLimit": 1,
    "progressiveDisclosure": true,
    "mobileTransform": "task-preserving-reflow",
    "largeScreenTransform": "context-expansion",
    "roleAdaptation": "priority-only",
    "maxReadableTextWidthToken": "content-readable",
    "stickyPrimaryAction": "task-dependent",
    "preserveTaskContext": true,
    "adaptivePersonalization": "bounded",
    "layoutDirection": "logical-properties",
    "reducedMotionRespect": true
  },
  "safety": {
    "roleAdaptationCannotGrantAuthority": true,
    "responsiveChangesCannotHideRequiredInformation": true,
    "largeScreenCannotAutoLoadMoreSensitiveData": true,
    "mobileTransformCannotChangeBusinessRules": true,
    "compositionDoesNotActivateComponentsOrInteractions": true
  }
}
