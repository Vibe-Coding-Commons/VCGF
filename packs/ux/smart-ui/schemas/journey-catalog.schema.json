{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCGF Smart Journey Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_version": {
      "const": "1.0.0"
    },
    "target_framework": {
      "const": "VCGF"
    },
    "target_framework_version": {
      "const": "1.3.0"
    },
    "status": {
      "const": "final-integration-candidate"
    },
    "activation_semantics": {
      "type": "string",
      "minLength": 1
    },
    "journeys": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VCGF-UI-JRN-[0-9]{3}$"
          },
          "journey": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "version": {
            "const": "1.0.0"
          },
          "status": {
            "const": "final-integration-candidate"
          },
          "path": {
            "type": "string",
            "pattern": "^journeys/"
          },
          "category": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "applies_when": {
            "type": "string"
          },
          "not_applicable_when": {
            "type": "string"
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "review_compositions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-SCR-[0-9]{3}$"
            }
          },
          "review_components": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-COMP-[0-9]{3}$"
            }
          },
          "review_interactions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-INT-[0-9]{3}$"
            }
          },
          "policies": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "default": {},
                "scope": {
                  "type": "string"
                },
                "constraints": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "type",
                "default",
                "scope",
                "constraints"
              ]
            }
          },
          "requirement_count": {
            "const": 12
          },
          "acceptance_count": {
            "const": 12
          }
        },
        "required": [
          "id",
          "journey",
          "title",
          "priority",
          "version",
          "status",
          "path",
          "category",
          "purpose",
          "applies_when",
          "not_applicable_when",
          "triggers",
          "review_compositions",
          "review_components",
          "review_interactions",
          "policies",
          "requirement_count",
          "acceptance_count"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "target_framework",
    "target_framework_version",
    "status",
    "activation_semantics",
    "journeys"
  ]
}
