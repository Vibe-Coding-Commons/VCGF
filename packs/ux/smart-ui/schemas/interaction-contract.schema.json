{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interaction pattern contracts",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "contracts": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "standard_id": {
            "type": "string",
            "pattern": "^VCGF-UI-INT-[0-9]{3}$"
          },
          "kind": {
            "const": "interaction-pattern"
          },
          "lifecycle_state": {
            "const": "final-integration-candidate"
          },
          "activation_policy": {
            "const": "explicit-selected-only"
          },
          "runtime_test_state": {
            "const": "not_run"
          },
          "evidence_required": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "review_components": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-COMP-[0-9]{3}$"
            }
          },
          "path": {
            "type": "string",
            "pattern": "^interactions/"
          }
        },
        "required": [
          "standard_id",
          "kind",
          "lifecycle_state",
          "activation_policy",
          "runtime_test_state",
          "evidence_required",
          "review_components",
          "path"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "contracts"
  ]
}
