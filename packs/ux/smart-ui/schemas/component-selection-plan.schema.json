      "const": "1.0.0"
    },
    "project_id": {
      "type": "string"
    },
    "screen_id": {
      "type": "string"
    },
    "selection_status": {
      "enum": [
        "no_ui",
        "selected",
        "needs_review"
      ]
    },
    "catalog_component_count": {
      "type": "integer",
      "minimum": 0
    },
    "interaction_pattern_count": {
      "type": "integer",
      "minimum": 0
    },
    "screen_composition_count": {
      "type": "integer",
      "minimum": 0
    },
    "journey_pattern_count": {
      "type": "integer",
      "minimum": 0
    },
    "selected_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "standard_id": {
            "type": "string"
          },
          "decision": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "matched_signals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "implementation_action": {
            "enum": [
              "reuse",
              "extend",
              "wrap",
              "replace",
              "build_new",
              "verify_first"
            ]
          },
          "standard_path": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "standard_id",
          "decision",
          "matched_signals",
          "implementation_action",
          "standard_path",
          "reason"
        ]
      }
    },
