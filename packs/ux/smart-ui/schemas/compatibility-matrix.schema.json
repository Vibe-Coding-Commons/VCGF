{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCGF Smart UI compatibility matrix",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "alternative",
              "complementary",
              "authority-boundary",
              "specialization",
              "mode-boundary"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "review"
            ]
          },
          "rule": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "left",
          "right",
          "type",
          "severity",
          "rule"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "relations"
  ]
}
