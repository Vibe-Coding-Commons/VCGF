{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCGF Smart Screen Composition Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_version": {
      "const": "1.0.0"
    },
    "target_framework": {
      "const": "VCGF"
    },
    "target_framework_version": {
      "const": "1.3.0"
    },
    "status": {
      "enum": [
        "integration-candidate",
        "adopted",
        "final-integration-candidate"
      ]
    },
    "activation_semantics": {
      "type": "string",
      "minLength": 1
    },
    "compositions": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^VCGF-UI-SCR-[0-9]{3}$"
          },
          "composition": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "primary",
              "modifier"
            ]
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "status": {
            "enum": [
              "integration-candidate",
              "final-integration-candidate"
            ]
          },
          "path": {
            "type": "string",
            "pattern": "^screen-compositions/"
          },
          "purpose": {
            "type": "string",
            "minLength": 20
          },
          "applies_when": {
            "type": "string",
            "minLength": 10
          },
          "not_applicable_when": {
            "type": "string",
            "minLength": 10
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 2
            }
          },
          "review_components": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-COMP-[0-9]{3}$"
            }
          },
          "review_interactions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-INT-[0-9]{3}$"
            }
          },
          "structure_summary": {
            "type": "string",
            "minLength": 20
          },
          "responsive_summary": {
            "type": "string",
            "minLength": 20
          },
          "policies": {
            "type": "array",
            "minItems": 6,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "string",
                    "boolean",
                    "integer",
                    "number",
                    "array"
                  ]
                },
                "default": {},
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "constraints": {
                  "type": "string",
                  "minLength": 10
                }
              },
              "required": [
                "key",
                "type",
                "default",
                "scope",
                "constraints"
              ]
            }
          },
          "requirement_count": {
            "const": 12
          },
          "acceptance_count": {
            "const": 12
          }
        },
        "required": [
          "id",
          "composition",
          "title",
          "kind",
          "priority",
          "version",
          "status",
          "path",
          "purpose",
          "applies_when",
          "not_applicable_when",
          "triggers",
          "review_components",
          "review_interactions",
          "structure_summary",
          "responsive_summary",
          "policies",
          "requirement_count",
          "acceptance_count"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "target_framework",
    "target_framework_version",
    "status",
    "activation_semantics",
    "compositions"
  ]
}
