{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VCGF Smart UI component contract registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "package_version": {
      "const": "1.0.0"
    },
    "contracts": {
      "type": "array",
      "minItems": 36,
      "maxItems": 36,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "standard_id": {
            "type": "string",
            "pattern": "^VCGF-UI-COMP-[0-9]{3}$"
          },
          "component_name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "lifecycle_state": {
            "const": "final-integration-candidate"
          },
          "criticality": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "activation_policy": {
            "const": "explicit-selected-only"
          },
          "discovery_signals": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "reuse_preference": {
            "const": [
              "reuse",
              "extend",
              "wrap",
              "replace",
              "build_new"
            ]
          },
          "review_relationships": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^VCGF-UI-COMP-[0-9]{3}$"
            },
            "uniqueItems": true
          },
          "external_bindings": {
            "type": "array",
            "items": {
              "enum": [
                "calendar",
                "searchable_select"
              ]
            },
            "uniqueItems": true
          },
          "required_evidence": {
            "type": "array",
            "minItems": 6,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "package_policy": {
            "type": "string",
            "minLength": 1
          },
          "runtime_test_state": {
            "const": "not_run"
          }
        },
        "required": [
          "standard_id",
          "component_name",
          "category",
          "lifecycle_state",
          "criticality",
          "activation_policy",
          "discovery_signals",
          "reuse_preference",
          "review_relationships",
          "external_bindings",
          "required_evidence",
          "package_policy",
          "runtime_test_state"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "package_version",
    "contracts"
  ]
}
